-- Le o numero que aparece em Character.Head.Overhead.AtividadeFisica.Container.Value
-- (o mesmo para polichinelos, flexoes e abdominais: o titulo muda, o Value e o contador)

local headObj = nil
local ready = true

local function findHeadLabel()
    if headObj and headObj.Parent then return headObj end
    headObj = nil
    local ch = player.Character
    if not ch then return nil end
    local af = ch:FindFirstChild("AtividadeFisica", true)
    if not af then return nil end
    local cont = af:FindFirstChild("Container") or af
    local v = cont:FindFirstChild("Value", true)
    if v and (v:IsA("TextLabel") or v:IsA("TextBox") or v:IsA("TextButton")) then
        headObj = v
    end
    return headObj
end

local function parseNumber(text)
    local t = string.gsub(tostring(text or ""), "<[^>]->", "")
    local tok = string.match(t, "%d[%d%.,]*")
    if not tok then return nil end
    return tonumber((string.gsub(tok, "[%.,]", "")))
end

local function readHead()
    local o = findHeadLabel()
    if not o then return nil end
    local n = parseNumber(o.Text)
    -- a quantidade maxima do script e 500; valores gigantes sao total acumulado/antigo, nao a sessao
    if n and n > 5000 then return nil end
    return n
end

local function beginRun()
    count = 0
end

-- progresso = numero REAL mostrado na cabeca (conta tambem os feitos manualmente).
-- So usa os cliques do script se o contador da cabeca nao existir.
local function progress()
    local v = readHead()
    if v then return v, true end
    return count, false
end

local function refresh()
    if mode.enabled then
        local p = progress()
        toggle.Text = mode.limit and ("PARAR  " .. p .. "/" .. mode.limit) or "PARAR"
        toggleGrad.Color = ON_SEQ
        toggleStroke.Color = ICE
    else
        toggle.Text = "INICIAR"
        toggleGrad.Color = OFF_SEQ
        toggleStroke.Color = BLUE_LIGHT
    end
    if not speedBox:IsFocused() then
        speedBox.Text = tostring(mode.delay)
    end
end

toggle.MouseButton1Click:Connect(function()
    mode.enabled = not mode.enabled
    if mode.enabled then beginRun() end
    refresh()
end)

qtyBox.FocusLost:Connect(function()
    local n = tonumber(qtyBox.Text)
    if n then
        n = math.clamp(math.floor(n), 1, 500)
        mode.limit = n
        qtyBox.Text = tostring(n)
    else
        mode.limit = nil
        qtyBox.Text = ""
    end
    refresh()
end)

speedBox.FocusLost:Connect(function()
    local n = tonumber((string.gsub(speedBox.Text, ",", ".")))
    if not n or n < MIN_DELAY then n = MIN_DELAY end
    mode.delay = n
    speedBox.Text = tostring(n)
end)

