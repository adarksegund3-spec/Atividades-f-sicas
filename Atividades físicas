local function refresh()
    if mode.enabled then
        local p = progress()
        local tag = ""
        if type(lastWorked) == "number" then
            tag = "  ·  M" .. lastWorked
        elseif lastWorked == "todos" then
            tag = "  ·  M*"
        end
        toggle.Text = (mode.limit and ("PARAR  " .. p .. "/" .. mode.limit) or "PARAR") .. tag
        toggleGrad.Color = ON_SEQ
        toggleStroke.Color = ICE
    else
        toggle.Text = "INICIAR"
        toggleGrad.Color = OFF_SEQ
        toggleStroke.Color = BLUE_LIGHT
    end
    if not speedBox:IsFocused() then
        speedBox.Text = tostring(mode.delay)
    end
end

