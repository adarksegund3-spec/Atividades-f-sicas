local accents = {
    {"ã", "a"}, {"á", "a"}, {"à", "a"}, {"â", "a"}, {"Ã", "a"}, {"Á", "a"}, {"À", "a"}, {"Â", "a"},
    {"é", "e"}, {"ê", "e"}, {"É", "e"}, {"Ê", "e"},
    {"í", "i"}, {"Í", "i"},
    {"ó", "o"}, {"ô", "o"}, {"õ", "o"}, {"Ó", "o"}, {"Ô", "o"}, {"Õ", "o"},
    {"ú", "u"}, {"Ú", "u"},
    {"ç", "c"}, {"Ç", "c"},
}

local function norm(s)
    s = tostring(s or "")
    if string.find(s, "[\128-\255]") then
        for _, p in ipairs(accents) do
            s = string.gsub(s, p[1], p[2])
        end
    end
    s = string.lower(s)
    s = string.gsub(s, "[%s%p]", "")
    return s
end

local function isVisible(obj)
    if obj.AbsoluteSize.X <= 0 or obj.AbsoluteSize.Y <= 0 then return false end
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

local function findButton(m)
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local target = norm(m.target)
    if target == "" then return nil end
    for _, obj in ipairs(pg:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("TextLabel")) and not obj:IsDescendantOf(gui) then
            local txt = norm(obj.Text)
            local match
            if m.exact then
                match = (txt == target)
            else
                match = (txt ~= "" and string.find(txt, target, 1, true) ~= nil)
            end
            if match then
                local btn = obj
                if not obj:IsA("TextButton") then
                    btn = obj:FindFirstAncestorWhichIsA("GuiButton")
                end
                if btn and isVisible(btn) then
                    return btn
                end
            end
        end
    end
    return nil
end

local function clickButton(btn)
    local done = false
    if getconnections then
        for _, ev in ipairs({btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(getconnections(ev)) do
                    c:Fire()
                    done = true
                end
            end)
        end
    end
    if done then return end

    if firesignal then
        local ok = pcall(function()
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
        end)
        if ok then return end
    end

    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local inset = GuiService:GetGuiInset()
        local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2 + inset
        vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
        vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
    end)
end

