local connections = {}
local scale = make("UIScale", {Scale = 1}, frame)

-- no PC a janela cresce um pouco em telas grandes; no mobile/console fica no tamanho original
local function applyScale()
    if not IS_PC then
        scale.Scale = 1
        return
    end
    local vp = gui.AbsoluteSize
    if vp.Y > 0 then
        scale.Scale = math.clamp(vp.Y / 800, 1, 1.35)
    end
end

-- impede a janela de sair da tela
local function clampFrame()
    local vp = gui.AbsoluteSize
    if vp.X <= 0 or vp.Y <= 0 then return end
    local ap, sz = frame.AbsolutePosition, frame.AbsoluteSize
    local dx, dy = 0, 0
    if ap.X + sz.X > vp.X then dx = vp.X - (ap.X + sz.X) end
    if ap.X + dx < 0 then dx = -ap.X end
    if ap.Y + sz.Y > vp.Y then dy = vp.Y - (ap.Y + sz.Y) end
    if ap.Y + dy < 0 then dy = -ap.Y end
    if dx ~= 0 or dy ~= 0 then
        local pos = frame.Position
        frame.Position = UDim2.new(pos.X.Scale, pos.X.Offset + dx / scale.Scale,
                                   pos.Y.Scale, pos.Y.Offset + dy / scale.Scale)
    end
end

table.insert(connections, gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
    applyScale()
    clampFrame()
end))
