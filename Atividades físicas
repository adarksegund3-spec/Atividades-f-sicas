do
    local dragging, dragStart, startPos
    table.insert(connections, top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end))
    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local d = (input.Position - dragStart) / scale.Scale
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                       startPos.Y.Scale, startPos.Y.Offset + d.Y)
            clampFrame()
        end
    end))
end

-- ===================== BUSCA DO BOTAO (COM CACHE, SEM LAG) =====================

local accents = {
    {"ã", "a"}, {"á", "a"}, {"à", "a"}, {"â", "a"}, {"Ã", "a"}, {"Á", "a"}, {"À", "a"}, {"Â", "a"},
    {"é", "e"}, {"ê", "e"}, {"É", "e"}, {"Ê", "e"},
    {"í", "i"}, {"Í", "i"},
    {"ó", "o"}, {"ô", "o"}, {"õ", "o"}, {"Ó", "o"}, {"Ô", "o"}, {"Õ", "o"},
    {"ú", "u"}, {"Ú", "u"},
    {"ç", "c"}, {"Ç", "c"},
}

local normCache = {}
local normCacheSize = 0

local function norm(s)
    s = tostring(s or "")
    local cached = normCache[s]
    if cached ~= nil then return cached end
    local raw = s
    if string.find(s, "[\128-\255]") then
        for _, p in ipairs(accents) do
            s = string.gsub(s, p[1], p[2])
        end
    end
    s = string.lower(s)
    s = string.gsub(s, "[%s%p]", "")
    if normCacheSize > 2000 then
        normCache = {}
        normCacheSize = 0
    end
    normCache[raw] = s
    normCacheSize = normCacheSize + 1
    return s
end

local function isVisible(obj)
    if obj.AbsoluteSize.X <= 0 or obj.AbsoluteSize.Y <= 0 then return false end
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

-- varre o PlayerGui devagar (cede o frame a cada X objetos) para nao travar o jogo
local function findButton(m)
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local target = norm(m.target)
    if target == "" then return nil end
    local list = pg:GetDescendants()
    for i, obj in ipairs(list) do
        if i % 250 == 0 then task.wait() end
        if obj.Parent and (obj:IsA("TextButton") or obj:IsA("TextLabel")) and not obj:IsDescendantOf(gui) then
            local txt = norm(obj.Text)
            local match
            if m.exact then
                if m.targets then
                    for _, t in ipairs(m.targets) do
                        if txt == t then match = true break end
                    end
                else
                    match = (txt == target)
                end
            else
                match = (txt ~= "" and string.find(txt, target, 1, true) ~= nil)
            end
            if match then
                local btn = obj
                if not obj:IsA("GuiButton") then
                    btn = obj:FindFirstAncestorWhichIsA("GuiButton")
                    -- PC: se a bolha nao e botao (o jogo pode ler o mouse direto), usa o proprio texto
                    if not btn and IS_PC then btn = obj end
                end
                if btn and isVisible(btn) then
                    return btn
                end
            end
        end
    end
    return nil
end

local cachedBtn = nil
local lastScan = 0

local function getButton()
    local now = os.clock()
    if cachedBtn and cachedBtn.Parent then
        -- botao ainda existe: so olha se esta visivel (barato, roda a cada tick)
        if isVisible(cachedBtn) then return cachedBtn end
        -- escondido: de vez em quando procura outro (caso a bolha tenha sido recriada)
        if now - lastScan < 0.5 then return nil end
    else
        cachedBtn = nil
        if now - lastScan < 0.12 then return nil end
    end
    lastScan = now
    local found = findButton(mode)
    if found then cachedBtn = found end
    return found
end

-- ===================== BOLHA DE TECLA (PC) =====================
-- No PC o jogo mostra uma letra (Q, E...) na bolha em vez de "tap": e pra APERTAR A TECLA.
-- (mesmo metodo do script DRIP MENU AUTO JJs: acha o botao com a letra e manda a tecla)

local function keyFromText(t)
    t = string.upper((string.gsub(tostring(t or ""), "%s+", "")))
    if #t == 1 and string.match(t, "%a") and t ~= "X" then
        local ok, kc = pcall(function() return Enum.KeyCode[t] end)
        if ok then return kc end
    end
    return nil
end

local SKIP_NAMES = {Close = true, Pause = true, Minimize = true}

local function findKeyBubble()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local roots = {}
    local pol = pg:FindFirstChild("Polichinelos")
    if pol then table.insert(roots, pol:FindFirstChild("Screen") or pol) end
    local af = pg:FindFirstChild("AtividadesFisicas")
    if af then table.insert(roots, af) end
    for _, root in ipairs(roots) do
        for i, obj in ipairs(root:GetDescendants()) do
            if i % 250 == 0 then task.wait() end
            if obj.Parent and (obj:IsA("TextLabel") or obj:IsA("TextButton")) and keyFromText(obj.Text) then
                local btn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton")
                if btn and not SKIP_NAMES[btn.Name] and not btn:FindFirstAncestor("Infos")
                and not btn:GetAttribute("Completed") and isVisible(btn) then
                    return btn, obj
                end
            end
        end
    end
    return nil
end

local cachedKeyBtn, cachedKeyLabel = nil, nil
local lastKeyScan = 0

local function getKeyBubble()
    if cachedKeyBtn and cachedKeyBtn.Parent and cachedKeyLabel and cachedKeyLabel.Parent
    and isVisible(cachedKeyBtn) then
        local k = keyFromText(cachedKeyLabel.Text)
        if k then return cachedKeyBtn, k end
    end
    local now = os.clock()
    if now - lastKeyScan < 0.12 then return nil end
    lastKeyScan = now
    local btn, lbl = findKeyBubble()
    if btn then
        cachedKeyBtn, cachedKeyLabel = btn, lbl
        return btn, keyFromText(lbl.Text)
    end
    cachedKeyBtn, cachedKeyLabel = nil, nil
    return nil
end

-- ===================== CLIQUE =====================
-- MOBILE: um metodo so (dispara os eventos do botao via getconnections/firesignal). Nao move
-- mouse, nao manda tecla nem toque, entao o jogo nao troca pra "modo PC" e a bolha nao some.
-- PC / CONSOLE: cadeia de metodos. Usa o que funciona e, se o contador da cabeca nao subir,
-- passa pro proximo metodo (sem nunca disparar dois metodos no mesmo clique).

-- inset: se a ScreenGui do botao ignora o inset, nao soma (senao o clique erra ~36px)
local function insetFor(btn)
    local sg = btn:FindFirstAncestorWhichIsA("ScreenGui")
    if sg and sg.IgnoreGuiInset then return Vector2.new(0, 0) end
    return GuiService:GetGuiInset()
end

local function centerOf(btn, flip)
    local p = btn.AbsolutePosition + btn.AbsoluteSize / 2
    local inset = insetFor(btn)
    if flip then
        if inset.X == 0 and inset.Y == 0 then
            inset = GuiService:GetGuiInset()
        else
            inset = Vector2.new(0, 0)
        end
    end
    return p + inset
end

local function fireEvents(btn)
    if not btn:IsA("GuiButton") then return false end
    local fired = false
    if getconnections then
        for _, ev in ipairs({btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(getconnections(ev)) do
                    c:Fire()
                    fired = true
                end
            end)
        end
    end
    if fired then return true end

    if firesignal then
        local ok = pcall(function()
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
        end)
        if ok then return true end
    end
    return false
end

local function vimClick(btn, flip)
    local vim = game:GetService("VirtualInputManager")
    local pos = centerOf(btn, flip)
    vim:SendMouseMoveEvent(pos.X, pos.Y, game)
    vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
    task.wait(0.03)
    vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
end

-- usado no mobile e pra pausar/fechar
local function clickButton(btn)
    if fireEvents(btn) then return end
    if IS_PC then
        pcall(vimClick, btn, false)
    end
end

