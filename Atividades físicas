local function statusText()
    local plat = IS_MOBILE and "MOBILE" or (IS_CONSOLE and "CONSOLE" or "PC")
    local function yn(v) return v and "OK" or "NAO" end
    local bolha = (cachedBtn ~= nil and cachedBtn.Parent ~= nil)
    if not bolha and cachedKeyLabel ~= nil and cachedKeyLabel.Parent ~= nil then
        bolha = true
    end
    local cont = (findHeadLabel() ~= nil)
    local met = "evento"
    if not IS_MOBILE then
        met = (lastMode == "tecla") and keyChain[keyIdx][1] or chain[chainIdx][1]
    end
    return plat .. " | getconn " .. yn(getconnections) .. " | firesig " .. yn(firesignal)
        .. " | bolha " .. yn(bolha) .. " | contador " .. yn(cont) .. " | " .. met
end

local function refresh()
    if SHOW_STATUS then
        pcall(function() statusLabel.Text = statusText() end)
    end
    if mode.enabled then
        local p = progress()
        local tag = ""
        if type(lastWorked) == "number" then
