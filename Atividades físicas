local function pathGet(root, names)
    local cur = root
    for _, n in ipairs(names) do
        if not cur then return nil end
        cur = cur:FindFirstChild(n)
    end
    return cur
end

local function finishRun()
    mode.enabled = false
    refresh()
    task.spawn(function()
        task.wait(0.4)
        local pg = player:FindFirstChild("PlayerGui")
        local pause = pg and pathGet(pg, {"AtividadesFisicas", "Main", "Background", "Infos", "Pause"})
        if not (pause and pause:IsA("GuiButton")) then
            pause = findButton({target = "pausar", exact = false})
        end
        if pause then
            clickAll(pause)
            task.wait(0.5)
        end
        local closeBtn = pg and pathGet(pg, {"AtividadesFisicas", "Main", "Background", "Close"})
        if closeBtn and closeBtn:IsA("GuiButton") then
            clickAll(closeBtn)
        end
    end)
end

-- cada ciclo roda numa thread separada (nao trava o loop nem o jogo)
local lastRefresh = 0

local function cycle()
    local now = os.clock()

    -- 1) depois de um clique com limite, espera o contador da cabeca mostrar o novo valor
    --    (assim nunca passa da quantidade escolhida)
    if awaiting then
        local h = readHead()
        if h ~= nil and h ~= awaiting.head then
            awaiting = nil
        elseif now - awaiting.t > 1.0 then
            awaiting = nil
        else
            return
        end
    end

    -- 2) chegou na quantidade? para ANTES de clicar de novo
    local p = progress()
    if mode.limit and p >= mode.limit then
        finishRun()
        return
    end

    -- 3) respeita o intervalo entre cliques (velocidade real = delay mostrado - SPEED_OFFSET)
    if now - lastClick < (mode.delay - SPEED_OFFSET) then return end

    -- 4) bolha visivel? clica na hora
    local btn = getButton()
    if btn then
        local headBefore = readHead()
        clickSmart(btn)
        lastClick = os.clock()
        if mode.limit and headBefore ~= nil then
            awaiting = {head = headBefore, t = lastClick}
        end
        if lastClick - lastRefresh > 0.25 then
            lastRefresh = lastClick
            refresh()
        end
    end
end

