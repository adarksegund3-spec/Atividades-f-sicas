-- ===================== BUSCA DO BOTAO (COM CACHE, SEM LAG) =====================

local accents = {
    {"ã", "a"}, {"á", "a"}, {"à", "a"}, {"â", "a"}, {"Ã", "a"}, {"Á", "a"}, {"À", "a"}, {"Â", "a"},
    {"é", "e"}, {"ê", "e"}, {"É", "e"}, {"Ê", "e"},
    {"í", "i"}, {"Í", "i"},
    {"ó", "o"}, {"ô", "o"}, {"õ", "o"}, {"Ó", "o"}, {"Ô", "o"}, {"Õ", "o"},
    {"ú", "u"}, {"Ú", "u"},
    {"ç", "c"}, {"Ç", "c"},
}

local normCache = {}
local normCacheSize = 0

local function norm(s)
    s = tostring(s or "")
    local cached = normCache[s]
    if cached ~= nil then return cached end
    local raw = s
    if string.find(s, "[\128-\255]") then
        for _, p in ipairs(accents) do
            s = string.gsub(s, p[1], p[2])
        end
    end
    s = string.lower(s)
    s = string.gsub(s, "[%s%p]", "")
    if normCacheSize > 2000 then
        normCache = {}
        normCacheSize = 0
    end
    normCache[raw] = s
    normCacheSize = normCacheSize + 1
    return s
end

local function isVisible(obj)
    if obj.AbsoluteSize.X <= 0 or obj.AbsoluteSize.Y <= 0 then return false end
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

-- varre o PlayerGui devagar (cede o frame a cada X objetos) para nao travar o jogo
local function findButton(m)
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local target = norm(m.target)
    if target == "" then return nil end
    local list = pg:GetDescendants()
    for i, obj in ipairs(list) do
        if i % 250 == 0 then task.wait() end
        if obj.Parent and (obj:IsA("TextButton") or obj:IsA("TextLabel")) and not obj:IsDescendantOf(gui) then
            local txt = norm(obj.Text)
            local match
            if m.exact then
                match = (txt == target)
            else
                match = (txt ~= "" and string.find(txt, target, 1, true) ~= nil)
            end
            if match then
                local btn = obj
                if not obj:IsA("GuiButton") then
                    btn = obj:FindFirstAncestorWhichIsA("GuiButton")
                end
                if btn and isVisible(btn) then
                    return btn
                end
            end
        end
    end
    return nil
end

local cachedBtn = nil
local lastScan = 0

local function getButton()
    local now = os.clock()
    if cachedBtn and cachedBtn.Parent then
        -- botao ainda existe: so olha se esta visivel (barato, roda a cada tick)
        if isVisible(cachedBtn) then return cachedBtn end
        -- escondido: de vez em quando procura outro (caso a bolha tenha sido recriada)
        if now - lastScan < 0.5 then return nil end
    else
        cachedBtn = nil
        if now - lastScan < 0.12 then return nil end
    end
    lastScan = now
    local found = findButton(mode)
    if found then cachedBtn = found end
    return found
end

-- ===================== CLIQUE (UM METODO SO) =====================
-- Dispara direto os eventos do botao (getconnections; se nao existir, firesignal).
-- NAO move mouse, NAO manda tecla, NAO manda toque: assim o jogo nao troca para "modo PC"
-- e a bolha continua aparecendo no mobile. Funciona igual no PC.
-- Mouse virtual so entra como ULTIMO recurso e SOMENTE em PC puro (sem touch).

local IS_TOUCH = UserInputService.TouchEnabled
local IS_PC = UserInputService.KeyboardEnabled and UserInputService.MouseEnabled and not IS_TOUCH

local function fireEvents(btn)
    local fired = false
    if getconnections then
        for _, ev in ipairs({btn.MouseButton1Click, btn.Activated, btn.MouseButton1Down, btn.MouseButton1Up}) do
            pcall(function()
                for _, c in ipairs(getconnections(ev)) do
                    c:Fire()
                    fired = true
                end
            end)
        end
    end
    if fired then return true end

    if firesignal then
        local ok = pcall(function()
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
        end)
        if ok then return true end
    end
    return false
end

local function clickButton(btn)
    if fireEvents(btn) then return end
    if IS_PC then
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local inset = GuiService:GetGuiInset()
            local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2 + inset
            vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
        end)
    end
end

