        end
    end)
end

-- cada ciclo roda numa thread separada (nao trava o loop nem o jogo)
local lastRefresh = 0

local function cycle()
    local now = os.clock()

    -- 1) depois de um clique com limite, espera o contador da cabeca mostrar o novo valor
    --    (assim nunca passa da quantidade escolhida)
    if awaiting then
        local h = readHead()
        if h ~= nil and h ~= awaiting.head then
            awaiting = nil
        elseif now - awaiting.t > 1.0 then
            awaiting = nil
        else
            return
        end
    end

    -- 2) chegou na quantidade? para ANTES de clicar de novo
    local p = progress()
    if mode.limit and p >= mode.limit then
        finishRun()
        return
    end

    -- 3) respeita o intervalo entre cliques (velocidade real = delay mostrado - SPEED_OFFSET)
    if now - lastClick < (mode.delay - SPEED_OFFSET) then return end

    -- 4) bolha visivel? clica na hora (PC: se nao ha "tap", procura bolha de tecla Q/E)
    local btn = getButton()
    local keyBtn, key
    if not btn and IS_PC then
        keyBtn, key = getKeyBubble()
    end
    if btn or (keyBtn and key) then
        local headBefore = readHead()
        local t0 = os.clock()
        if btn then
            lastMode = "tap"
            clickSmart(btn)
        else
            lastMode = "tecla"
            pressSmart(key)
        end
        lastClick = t0
        if mode.limit and headBefore ~= nil then
            awaiting = {head = headBefore, t = lastClick}
        end
        if lastClick - lastRefresh > 0.25 then
            lastRefresh = lastClick
            refresh()
        end
    end
end

