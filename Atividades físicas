-- ===================== CONTADOR DA CABECA =====================
-- Le o numero que aparece em Character.Head.Overhead.AtividadeFisica.Container.Value

local headObj = nil

local function findHeadLabel()
    if headObj and headObj.Parent then return headObj end
    headObj = nil
    local ch = player.Character
    if not ch then return nil end
    local af = ch:FindFirstChild("AtividadeFisica", true)
    if not af then return nil end
    local cont = af:FindFirstChild("Container") or af
    local v = cont:FindFirstChild("Value", true)
    if v and (v:IsA("TextLabel") or v:IsA("TextBox") or v:IsA("TextButton")) then
        headObj = v
    end
    return headObj
end

local function parseNumber(text)
    local t = string.gsub(tostring(text or ""), "<[^>]->", "")
    local tok = string.match(t, "%d[%d%.,]*")
    if not tok then return nil end
    return tonumber((string.gsub(tok, "[%.,]", "")))
end

local function readHead()
    local o = findHeadLabel()
    if not o then return nil end
    local n = parseNumber(o.Text)
    if n and n > 5000 then return nil end
    return n
end

local function beginRun()
    count = 0
end

local function progress()
    local v = readHead()
    if v then return v, true end
    return count, false
end

-- ===================== CLIQUE DO CICLO =====================

local lastWorked = nil
local lastMode = "tap"
local keyIdx = 1
local keyFails = 0
local lastClick = 0
local awaiting = nil -- clique feito, esperando o contador da cabeca atualizar
local chainIdx = 1
local chainFails = 0

local function clickSmart(btn)
    count = count + 1

    -- mobile: metodo unico, sem esperas
    if IS_MOBILE then
        clickButton(btn)
        return
    end

    -- PC / console: usa o metodo atual da cadeia
    local before = readHead()
    pcall(chain[chainIdx][2], btn)
    lastWorked = chainIdx
    if before == nil then return end

    -- confere se o contador subiu; se falhar 2 vezes seguidas, troca de metodo
    local t = 0
    while t < 0.3 do
        task.wait(0.05)
        t = t + 0.05
        local now = readHead()
        if now ~= nil and now ~= before then
            chainFails = 0
            return
        end
    end
    chainFails = chainFails + 1
    if chainFails >= 2 then
        chainFails = 0
        chainIdx = chainIdx % #chain + 1
    end
end

-- PC: aperta a tecla da bolha (Q/E...). Mesma logica: se o contador nao subir 2x seguidas, troca de metodo.
local function pressSmart(key)
    count = count + 1
    local before = readHead()
    pcall(keyChain[keyIdx][2], key)
    lastWorked = keyIdx
    if before == nil then return end
    local t = 0
    while t < 0.3 do
        task.wait(0.05)
        t = t + 0.05
        local now = readHead()
        if now ~= nil and now ~= before then
            keyFails = 0
            return
        end
    end
    keyFails = keyFails + 1
    if keyFails >= 2 then
        keyFails = 0
        keyIdx = keyIdx % #keyChain + 1
    end
end

-- usado pra pausar/fechar
local function clickAll(btn)
    clickButton(btn)
end

