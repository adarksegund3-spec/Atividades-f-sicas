local function pathGet(root, names)
    local cur = root
    for _, n in ipairs(names) do
        if not cur then return nil end
        cur = cur:FindFirstChild(n)
    end
    return cur
end

local function finishRun()
    mode.enabled = false
    refresh()
    task.spawn(function()
        task.wait(0.4)
        local pg = player:FindFirstChild("PlayerGui")
        local pause = pg and pathGet(pg, {"AtividadesFisicas", "Main", "Background", "Infos", "Pause"})
        if not (pause and pause:IsA("GuiButton")) then
            pause = findButton({target = "pausar", exact = false})
        end
        if pause then
            clickButton(pause)
            task.wait(0.5)
        end
        local closeBtn = pg and pathGet(pg, {"AtividadesFisicas", "Main", "Background", "Close"})
        if closeBtn and closeBtn:IsA("GuiButton") then
            clickButton(closeBtn)
        end
    end)
end

task.spawn(function()
    while running do
        task.wait(mode.delay)
        if running and mode.enabled then
            local p = progress()
            if mode.limit and p >= mode.limit then
                finishRun()
            else
                local btn = findButton(mode)
                if btn then
                    clickButton(btn)
                    count = count + 1
                end
                refresh()
            end
        end
    end
end)

task.spawn(function()
    while running do
        task.wait(1)
        if running then refresh() end
    end
end)

